# --- Python ---
.venv-anonymizer/
.venv-corpus-labeler-build/
.venv/
__pycache__/
*.py[cod]

# --- Local config (may hold credentials) ---
config/*.local.json
config/*.local.json.bak

# --- Downloaded model weights (1.1 GB; re-fetch, don't commit) ---
# See AGENTS.md for the download command. Path is referenced by
# config/sanitizer.json and tools/anonymize_construction_pdfs.py.
models/

# --- Client source documents (contain the PII this tool strips) ---
*.pdf
!tests/fixtures/**/*.pdf

# --- Generated output ---
output/

# --- PyInstaller build artifacts (tools/build_corpus_labeler_executable.py) ---
/build/
/dist/
labeled-output/

# --- Scratch / intermediate working dirs ---
tmp/

# NOTE: .scratch/ is intentionally NOT ignored. It holds specs and issue
# tickets (see docs/agents/issue-tracker.md) and is meant to be versioned
# with the code it describes. Don't add it here out of habit.
#
# One exception in practice, not in this file: .scratch/corpus/documents/
# holds the real locked-corpus PDFs. It needs no separate rule — the
# blanket *.pdf rule above already covers it — but is called out here so
# nobody "fixes" that by un-ignoring it. The corpus's metadata
# (manifest.json, labels/, intake_seeds/) stays tracked as normal.

# --- macOS ---
.DS_Store
