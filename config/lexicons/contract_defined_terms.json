{
  "_about": {
    "purpose": "Capitalized defined terms that appear in nearly every US construction contract (AIA A201/A101/A701, EJCDC boilerplate) and in CSI-format specifications. These are industry convention, not project-specific, so a detector flagging them as an organization or person is always wrong.",
    "matching": "A candidate is suppressed ONLY when its entire span, trimmed of surrounding punctuation and whitespace and with a possessive/plural affix removed, case-insensitively equals one of these terms. Never a substring match — 'City of Panama City' must survive when 'City' is listed.",
    "scope": "Project-independent. Safe to share across every project.",
    "warning": "Do not add a term here that could ever be a party's actual registered name. Suppression here is unconditional."
  },
  "match": "exact_span_case_insensitive",
  "strip_chars": " \t\n.,:;-—–'’\"()[]{}*#·|_",
  "strip_affixes": ["'s", "’s", "s'", "’", "'", "s"],
